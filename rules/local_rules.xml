<!-- =====================================================================
     Reglas personalizadas - Proyecto Final SI 2026 (wazuh-server)
     IDs desde 100001.
     ===================================================================== -->

<!-- ===== 1) Fuerza bruta SSH (T1110.001) - nivel 10 =====
     Base: 5760 (fallo de autenticacion SSH), confirmado con wazuh-logtest.
     same_source_ip agrupa por IP origen; frequency=6 + timeframe=60 => mas de
     5 fallos en 60 s (umbral de F1). Dispara el Active Response del Paso 1.9. -->
<group name="local,syslog,sshd,">
  <rule id="100001" level="10" frequency="6" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>Fuerza bruta SSH: mas de 5 fallos en 60 s desde la misma IP ($(srcip)).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>
</group>

<!-- ===== 2) Modificacion de /etc/passwd o /etc/sudoers via FIM (T1548.003) - nivel 12 =====
     Base: 550 (archivo modificado) y 554 (archivo nuevo). Filtra por ruta con
     el campo file. No se prueba con logtest: se valida en vivo (Paso 1.7). -->
<group name="local,syscheck,">
  <rule id="100002" level="12">
    <if_sid>550,554</if_sid>
    <field name="file">^/etc/passwd$|^/etc/sudoers$</field>
    <description>Modificacion no autorizada de $(file) detectada por FIM.</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>syscheck,</group>
  </rule>
</group>

<!-- ===== 3) sudo por usuario no privilegiado (T1548.003) - nivel 10 =====
     Base: 5405 (user NOT in sudoers), confirmado con wazuh-logtest. -->
<group name="local,syslog,sudo,">
  <rule id="100003" level="10">
    <if_sid>5405</if_sid>
    <description>Uso de sudo por usuario no autorizado (no esta en sudoers).</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>privilege_escalation,</group>
  </rule>
</group>


<!-- ===== 4) Conexion al puerto 4444 / reverse shell (T1041 + T1571) - nivel 12 =====
     Base: 4100, el mismo SID del log del firewall sobre el que se construye la
     regla de escaneo (100009 / 100006).
     Filtra por puerto DESTINO. El diseno original filtraba por puerto origen,
     buscando que el srcip de la alerta fuera Kali, pero el log real de UFW de
     agent-linux demostro que eso no ocurre nunca:

       [UFW ALLOW] IN= OUT=enp0s8 SRC=192.168.100.20 DST=192.168.100.99
                   PROTO=TCP SPT=59816 DPT=4444

     UFW registra la conexion SALIENTE hacia Kali:4444, pero no las respuestas:
     son trafico de una conexion ya establecida y no se loguea. No existe
     ninguna linea con SPT=4444, asi que una regla por puerto origen no
     disparaba nunca.

     Consecuencia a tener en cuenta al leer la alerta: srcip es el equipo
     COMPROMETIDO (agent-linux) y dstip es la maquina ATACANTE (Kali). Para un
     reverse shell esa es la lectura correcta: lo que se detecta es un host
     interno iniciando una conexion saliente hacia un puerto de C2.

     Por eso mismo esta regla NO debe activar firewall-drop: bloquearia al
     propio equipo atacado. La respuesta aqui es la notificacion.

     srcport y dstport son campos estaticos de Wazuh: llevan etiqueta propia,
     no <field name="...">. -->
<group name="local,firewall,">
  <rule id="100004" level="12">
    <if_sid>4100</if_sid>
    <dstport>4444</dstport>
    <description>Posible reverse shell: $(srcip) abre conexion saliente hacia $(dstip):4444.</description>
    <mitre>
      <id>T1041</id>
      <id>T1571</id>
    </mitre>
    <group>recon,attacks,</group>
  </rule>
</group>
<!-- ===== 5) Creacion de cuenta en Windows fuera de horario (T1136.001) - nivel 10 =====
     Event ID 4720 (se creo una cuenta de usuario) en el canal Security.
     Se matchea por campo, sin if_sid, igual que la regla 100007: los campos
     win.* son los mismos tanto si el evento se decodifica como JSON en una
     prueba de logtest como si llega por windows_eventchannel en produccion,
     asi que no hace falta depender de un SID de fabrica.
     Restringir al canal Security evita falsos positivos de otros registros.
     <time> limita la deteccion a fuera de la jornada laboral: crear una cuenta
     a las 3 de la madrugada es el indicador, no crear una cuenta. -->
<group name="local,windows,">
  <rule id="100005" level="10">
    <field name="win.system.eventID">^4720$</field>
    <field name="win.system.channel">^Security$</field>
    <time>6:00 pm - 8:00 am</time>
    <description>Creacion de cuenta en Windows fuera de horario laboral: $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>account_changes,windows,</group>
  </rule>
</group>

<!-- ===== 6) Escaneo de puertos (T1046) =====
     100009 es el atomo: la regla base 4100 del firewall es NIVEL 0 y las reglas
     de nivel 0 no generan alerta, asi que la correlacion no las puede contar
     (confirmado con logtest: 20 eventos en 4100 y la frequency nunca llego).
     100009 sube cada conexion a nivel 3 para que si entre en la cola, y 100006
     correlaciona sobre ella. Nivel 3 no notifica (politica de F1 = nivel 10+). -->
<group name="local,firewall,">
  <rule id="100009" level="3">
    <if_sid>4100</if_sid>
    <description>Conexion registrada por el firewall: $(srcip) -> $(dstip):$(dstport).</description>
    <group>firewall,</group>
  </rule>

  <rule id="100006" level="10" frequency="8" timeframe="60">
    <if_matched_sid>100009</if_matched_sid>
    <same_source_ip />
    <description>Escaneo de puertos: multiples conexiones desde la misma IP ($(srcip)) en 60 s.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,attacks,</group>
  </rule>
</group>

<!-- ===== 7) Escalada de privilegios: Event ID 7045 (T1068) - nivel 10 =====
     Instalacion de servicio/driver en Windows (ataque #3 de F5, BYOVD).
     Se matchea por campo, sin decoded_as ni if_sid: en logtest el evento cae en
     el decoder 'json' y en produccion en 'windows_eventchannel', y los campos
     win.* son los mismos en ambos. El canal System evita falsos positivos.
     En la reunion (J.5), confirmar el SID base y, si hay uno limpio, agregar
     <if_sid>SID</if_sid> para no duplicar la alerta. -->
<group name="local,windows,">
  <rule id="100007" level="10">
    <field name="win.system.eventID">^7045$</field>
    <field name="win.system.channel">^System$</field>
    <description>Escalada de privilegios: instalacion de servicio/driver en Windows (Event ID 7045) - $(win.eventdata.serviceName)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,windows,</group>
  </rule>
</group>


<!-- ===== 8) Inyeccion SQL en Apache (T1190) - nivel 10 =====
     Wazuh detecta SQLi en logs web con cinco reglas (31103, 31164, 31165, 31170,
     31171), todas en nivel 6-7: segun la politica de F1 no generan notificacion.
     Esta regla las eleva a nivel 10 y les agrega el mapeo MITRE.
     Se listan los SID y no se usa if_group porque los grupos de fabrica son
     inconsistentes: la 31164 esta en el grupo sqlinjection y la 31103 no
     (confirmado con wazuh-logtest).
     Excluidas a proposito:
       - 31152: ya es nivel 10 y es una correlacion encima de las anteriores.
       - 31106: "web attack returned 200" es hija de la 31103 pero tambien de las
         reglas de XSS; encadenar ahi etiquetaria un XSS como inyeccion SQL. -->
<group name="local,">
  <rule id="100008" level="10">
    <if_sid>31103,31164,31165,31170,31171</if_sid>
    <description>Inyeccion SQL detectada en Apache desde $(srcip): $(url)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,sqlinjection,</group>
  </rule>
</group>



<!-- ===== 9) PostgreSQL - IDs 100010-100012 =====
     Dependen de los decoders de decoders/local_decoder.xml: sin ellos los
     eventos de PostgreSQL no se decodifican y estas reglas nunca disparan.
     Empiezan en 100010 porque 100009 ya lo usa el atomo del firewall (regla 6).
     Si logtest muestra que el decoder que dispara se llama distinto de
     'postgresql-local', hay que cambiar el <decoded_as> de 100010 y 100012. -->
<group name="local,postgresql,">

  <!-- Un fallo de autenticacion: es el atomo de la 100011, mismo patron que
       el par 100009/100006 del firewall.
       NIVEL 6, NO 5, A PROPOSITO: Wazuh evalua las reglas por nivel de mayor a
       menor y, dentro del mismo nivel, por orden de carga (las de etc/rules/
       van despues de las de fabrica). Con nivel 5 esta regla ni se intentaba:
       la regla de fabrica 2501 'syslog: User authentication failure', tambien
       de nivel 5, matcheaba antes y cortaba la evaluacion (confirmado con
       wazuh-logtest -v). Con nivel 6 se evalua antes que la 2501.
       Alternativa descartada: colgarla de la 2501 con <if_sid>2501</if_sid>.
       Se prefiere que sea independiente, porque la 2501 matchea por texto
       generico y no esta garantizado que coincida con la linea real de
       agent-db. Nivel 6 no notifica (la politica de F1 notifica a partir
       de 10): la notificacion la dispara la 100011. -->
  <rule id="100010" level="6">
    <decoded_as>postgresql-local</decoded_as>
    <match>password authentication failed</match>
    <description>PostgreSQL: fallo de autenticacion del usuario $(dstuser) en la base $(pg_db).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- Fuerza bruta contra la base de datos: mismo umbral que la 100001.
       Sin same_source_ip porque el log de PostgreSQL no trae IP de origen
       salvo que se agregue %h al log_line_prefix de agent-db. -->
  <rule id="100011" level="10" frequency="6" timeframe="60">
    <if_matched_sid>100010</if_matched_sid>
    <description>Fuerza bruta contra PostgreSQL: mas de 5 fallos de autenticacion en 60 s.</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- Consulta malformada: es el rastro que deja sqlmap del lado de la base de
       datos mientras sondea. Complementa la 100008, que lo ve desde Apache. -->
  <rule id="100012" level="7">
    <decoded_as>postgresql-local</decoded_as>
    <match>syntax error at or near</match>
    <description>PostgreSQL: consulta SQL malformada (posible sondeo de inyeccion).</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>sql_injection,</group>
  </rule>

</group>

<!-- ===== 10) Inyeccion SQL sin codificar en Apache (T1190) - nivel 10 =====
     Complemento de la 100008, que cuelga de las reglas web de fabrica
     (31103, 31164...). Esas reglas dependen del decoder de fabrica
     'web-accesslog', cuyo prematch exige que la URL no tenga espacios
     ("\w+ \S+ HTTP\S+"). Una peticion con el payload SIN codificar
     (?id=1' OR '1'='1) no la decodifica nadie y no genera ninguna alerta.
     Esta regla cubre ese hueco apoyandose en el decoder propio
     apache-accesslog-local (ver decoders/local_decoder.xml). -->
<group name="local,">
  <rule id="100013" level="10">
    <decoded_as>apache-accesslog-local</decoded_as>
    <!-- 'url' es un campo estatico de Wazuh: no se puede filtrar con
         <field name="url">. Se busca el patron con <regex> sobre la linea
         completa, acotado a lo que va dentro de las comillas de la peticion,
         para no matchear el user-agent ni el referer. -->
    <regex type="pcre2">(?i)"\w+ [^"]*(union\s+.*select|'\s*or\s*'1'\s*=\s*'1|or\s+1\s*=\s*1|information_schema|sleep\s*\(|benchmark\s*\()</regex>
    <description>Inyeccion SQL sin codificar en Apache desde $(srcip): $(url)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,sqlinjection,</group>
  </rule>
</group>

<!-- ===== 11) Archivo nuevo o modificado en directorio de riesgo - nivel 5 =====
     Regla de enganche para la integracion con VirusTotal (Paso 1.10).
     No pretende detectar nada por si sola: existe para acotar que alertas de
     FIM se mandan a analizar.
     Motivo: la API gratuita de VirusTotal permite 4 consultas por minuto. Con
     <group>syscheck</group> la integracion se disparaba con cada cambio en
     /etc -que en un sistema en marcha son rafagas de alertas 550- y VirusTotal
     devolvia 429; el script lo interpreta como "sin respuesta" y termina con
     ERR_NO_RESPONSE_VT (codigo 4). Confirmado en los logs de wazuh-integratord.
     Ambitos elegidos:
       /opt/vt-test : directorio de pruebas del manager.
       /var/www     : raiz del sitio de agent-linux, donde caeria una webshell
                      tras la inyeccion SQL del ataque #2 de la Fase 5.
     Ninguno de los dos cambia por si solo, asi que la cuota alcanza. -->
<group name="local,syscheck,">
  <rule id="100014" level="5">
    <if_sid>550,554</if_sid>
    <field name="file">^/opt/vt-test/|^/var/www/</field>
    <description>Archivo nuevo o modificado en directorio de riesgo: $(file)</description>
    <group>syscheck,virustotal,</group>
  </rule>
</group>

<!-- ===== 12) Inyeccion SQL codificada en la URL (T1190) - nivel 10 =====
     Tercer caso de SQLi, y el mas comun en la practica. Las reglas web de
     fabrica (31103, 31164...) detectan por PALABRA CLAVE: union, select,
     insert. Una tautologia como

         /pagina.php?id=1%27+OR+%271%27%3D%271     ->  id=1' OR '1'='1

     no tiene ninguna palabra clave SQL: solo comillas codificadas (%27), un
     OR y un igual (%3D). Comprobado con wazuh-logtest sobre una peticion real
     de agent-linux: solo matcheaba la 31100 (nivel 0, contenedora), asi que
     ni las reglas de fabrica ni la 100008 ni la 100013 la cubrian.

     Cuelga de la 31100 para evaluarse como hermana de las reglas web de
     fabrica: si alguna de ellas matchea primero, gana la suya; esta actua
     como red para lo que dejan pasar.

     El patron exige las tres cosas juntas -comilla, operador logico aislado e
     igual- dentro de las comillas de la peticion, para no marcar como ataque
     una URL legitima que simplemente contenga la palabra "or". -->
<group name="local,">
  <rule id="100015" level="10">
    <if_sid>31100</if_sid>
    <regex type="pcre2">(?i)"\w+ [^"]*(?:%27|%22|'|")[^"]*(?:\+|%20|\s)(?:or|and)(?:\+|%20|\s)[^"]*(?:%3d|=)</regex>
    <description>Inyeccion SQL codificada en URL desde $(srcip): $(url)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,sqlinjection,</group>
  </rule>
</group>
