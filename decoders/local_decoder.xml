<!-- =====================================================================
     Decodificadores personalizados - Proyecto Final SI 2026 (wazuh-server)
     Paso 1.8 / Fase 3 paso 12.
     En el manager: /var/ossec/etc/decoders/local_decoder.xml
     =====================================================================
     ===================================================================== -->


<!-- =====================================================================
     1) APACHE - access.log
     =====================================================================
     ===================================================================== -->
<decoder name="apache-accesslog-local">
  <prematch type="pcre2">^\S+ \S+ \S+ \[\d{2}/\w{3}/\d{4}:\d{2}:\d{2}:\d{2} [^\]]*\] "</prematch>
  <regex type="pcre2">^(\S+) \S+ \S+ \[[^\]]+\] "(\w+)\s+(.+?)\s+HTTP/[0-9.]+"\s+(\d{3})\s+\S+\s+"[^"]*"\s+"([^"]*)"</regex>
  <order>srcip, protocol, url, id, http_user_agent</order>
</decoder>


<!-- =====================================================================
     2) POSTGRESQL
     =====================================================================
     De fabrica: 0225-postgresql_decoders.xml, decoder 'postgresql_log' con
         <prematch>^[\d\d\d\d-\d\d-\d\d \S+ \w+] </prematch>
     es decir, espera la fecha ENTRE CORCHETES, formato antiguo:
         [2007-08-31 18:37:09.454 ADT] 192.168.2.99: LOG:  ...

     agent-db es Debian 12 con PostgreSQL 15, cuyo log_line_prefix por defecto
     es '%m [%p] %q%u@%d ' y produce:
         2026-10-21 14:03:11.123 UTC [12345] appuser@proyectodb FATAL:  ...

     La fecha NO va entre corchetes, asi que el decoder de fabrica no hace
     match y, en consecuencia, las reglas de fabrica 50500-50581 (que usan
     <decoded_as>postgresql_log</decoded_as>, entre ellas la 50512 "Database
     authentication failure", nivel 9) nunca disparan. De ahi que este decoder
     propio sea necesario, no opcional.
     ===================================================================== -->
<decoder name="postgresql-local">
  <prematch type="pcre2">^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d+ \S+ \[\d+\] </prematch>
</decoder>

<!-- Autenticacion fallida -> reglas 100010 / 100011 (T1110.001) -->
<decoder name="postgresql-local-auth">
  <parent>postgresql-local</parent>
  <prematch type="pcre2">FATAL:\s+password authentication failed</prematch>
  <regex type="pcre2">\[(\d+)\]\s+(\S*)@(\S*)\s+(FATAL):\s+password authentication failed for user "([^"]+)"</regex>
  <order>pg_pid, pg_user, pg_db, status, dstuser</order>
</decoder>

<!-- Consulta malformada u otro error -> regla 100012 (T1190) -->
<decoder name="postgresql-local-error">
  <parent>postgresql-local</parent>
  <prematch type="pcre2">\sERROR:\s</prematch>
  <regex type="pcre2">\[(\d+)\]\s+(\S*)@(\S*)\s+(ERROR):\s+(.+)</regex>
  <order>pg_pid, pg_user, pg_db, status, pg_error</order>
</decoder>

<!-- Generico con sesion (LOG, WARNING, otros FATAL...). Usa el mismo campo
     'status' que el decoder de fabrica, para no inventar semantica. -->
<decoder name="postgresql-local-sesion">
  <parent>postgresql-local</parent>
  <prematch type="pcre2">\[\d+\]\s+\S+@\S+\s+\w+:</prematch>
  <regex type="pcre2">\[(\d+)\]\s+(\S*)@(\S*)\s+(\w+):</regex>
  <order>pg_pid, pg_user, pg_db, status</order>
</decoder>

<!-- Generico sin sesion: %q omite user@db en los mensajes de arranque y
     mantenimiento del servidor. Es el ultimo, sin prematch, como red de
     seguridad para que el evento no quede sin campos. -->
<decoder name="postgresql-local-servidor">
  <parent>postgresql-local</parent>
  <regex type="pcre2">\[(\d+)\]\s+(\w+):</regex>
  <order>pg_pid, status</order>
</decoder>
